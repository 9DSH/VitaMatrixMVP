<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WhiteEditTextStyle" parent="Widget.AppCompat.EditText">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textColorHint">#424242</item>
        <item name="android:background">@drawable/white_radius_bg</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="WhiteButtonStyle" parent="Widget.AppCompat.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#000000</item>
        <item name="android:background">@drawable/ripple_background</item>
        <item name="android:padding">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:gravity">center</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="CustomHorizontalProgress" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/my_progressbar</item>
        <item name="android:background">@drawable/progress_background_white</item>
        <item name="android:minHeight">16dp</item>
        <item name="android:maxHeight">16dp</item>
    </style>

    <style name="Title" >
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="h1" >
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="question" >
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/questionsText</item>
    </style>

    <style name="CustomCheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:button">@drawable/custom_checkbox</item>
        <item name="android:textColor">@color/questionsText</item>

        <item name="buttonTint">@null</item>
        <item name="android:buttonTint">@null</item>
        <item name="materialThemeOverlay">@null</item>

        <item name="android:textSize">16sp</item>

    </style>

    <style name="Description" >
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/descriptions</item>
    </style>

    <style name="WorkoutTitle" >
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/blue</item>
    </style>

    <style name="Workout" >
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/blue_light</item>
    </style>

    <style name="smallText" >
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CustomBottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="iconSize">36dp</item> <!-- اندازه آیکون‌ها را تنظیم کنید -->
    </style>


</resources>