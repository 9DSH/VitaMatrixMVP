<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingEnd="10dp"
    android:paddingStart="10dp"
    android:background="@color/background"
    android:fitsSystemWindows="true">
    <ImageView
        android:src="@drawable/vita_logo"
        android:layout_width="200dp"
        android:layout_height="100dp" />
    <LinearLayout
        android:layout_margin="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/profile_card_background" >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/avatar"
                android:layout_margin="15dp"
                app:civ_border_color="@color/colorAccent"
                app:civ_border_width="1dp"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/avatar3" />
            <TextView
                android:textColor="@color/questionsText"
                android:id="@+id/name"
                android:layout_weight="1"
                android:textSize="26dp"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >
            <LinearLayout
                android:layout_margin="5dp"
                android:background="@drawable/profile_small_card_background"
                android:layout_weight="3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal" >
                <TextView
                    android:textColor="@color/questionsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Height" />
                <TextView
                    android:id="@+id/height"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#ff851b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ffa62e"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="cm" />
            </LinearLayout>
            <LinearLayout
                android:layout_margin="5dp"
                android:background="@drawable/profile_small_card_background"
                android:layout_weight="3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal" >
                <TextView
                    android:textColor="@color/questionsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weight" />
                <TextView
                    android:id="@+id/weight"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#ff851b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ffa62e"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="kg" />
            </LinearLayout>
            <LinearLayout
                android:layout_margin="5dp"
                android:background="@drawable/profile_small_card_background"
                android:layout_weight="2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal" >
                <TextView
                    android:textColor="@color/questionsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Age" />
                <TextView
                    android:id="@+id/age"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#ff851b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:gravity="center_vertical"
        android:layout_margin="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/profile_card_background" >
        <TextView
            android:layout_weight="1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/questionsText"
            android:layout_margin="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Your Target" />
        <com.swings.vitamatrix.utils.wheelpicker.WheelPicker
            android:layout_marginEnd="20dp"
            android:layout_marginStart="20dp"
            android:id="@+id/wheelPicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:wheel_atmospheric="true"
            app:wheel_curved="false"
            app:wheel_cyclic="true"
            app:wheel_indicator="true"
            app:wheel_indicator_color="@color/questionsText"
            app:wheel_visible_item_count="3"
            app:wheel_item_align="center"
            app:wheel_item_text_color="@color/questionsText"
            app:wheel_item_text_size="18sp"
            app:wheel_selected_item_text_color="@color/questionsText" />
        <com.weigan.loopview.LoopView
            android:visibility="gone"
            android:textColor="@color/questionsText"
            android:layout_weight="1"
            app:awv_textsize="14"
            app:awv_itemsVisibleCount="5"
            android:id="@+id/loopview"
            android:layout_margin="10dp"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:src="@drawable/next" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/personalData"
        android:gravity="center_vertical"
        android:layout_margin="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/profile_card_background" >
        <TextView
            android:textColor="@color/questionsText"
            android:layout_weight="1"
            android:layout_margin="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Personal Data" />
        <ImageView
            android:layout_margin="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/next" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/resetData"
        android:gravity="center_vertical"
        android:layout_margin="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/profile_card_background" >
        <TextView
            android:textColor="@color/red"
            android:layout_weight="1"
            android:layout_margin="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Reset Data" />
    </LinearLayout>

</LinearLayout>