<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- حالت انتخاب شده -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorPrimary" /> <!-- رنگ بک‌گراند تب انتخاب شده -->
            <corners android:radius="16dp" /> <!-- اگر می‌خواهید گوشه‌ها گرد باشند -->
        </shape>
    </item>
    <!-- حالت عادی -->
    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/holo_red_dark" /> <!-- بک‌گراند شفاف برای تب‌های غیرفعال -->
        </shape>
    </item>
</selector>