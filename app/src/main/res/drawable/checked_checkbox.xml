<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <size
                android:width="45dp"
                android:height="45dp"/>
        </shape>
    </item>

    <!-- لایه اصلی نارنجی -->
    <item
        android:width="34dp"
        android:height="34dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFA500"/>
        </shape>
    </item>

    <!-- لایه حاشیه سفید -->
    <item
        android:width="30dp"
        android:height="30dp"
        android:gravity="center">
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#FFFFFF"/>
        </shape>
    </item>

</layer-list>